<launch>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ARGUMENTS  —  override on command line
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Path to anchors config (loaded into /uwb_imu_fusion namespace) -->
  <arg name="config_file"
       default="$(find uwb_imu_fusion)/config/anchors.yaml"/>
  <!-- ROS topic names -->
  <arg name="imu_topic"        default="/imu_data"/>
  <arg name="uwb_topic"        default="/tdoa_data"/>
  <arg name="gt_topic"         default="/pose_data"/>

  <!-- TF frame IDs -->
  <arg name="odom_frame"       default="map"/>
  <arg name="base_frame"       default="base_link"/>

  <!-- IMU unit flags (must match the physical sensor output) -->
  <arg name="imu_accel_in_g"   default="true"/>   <!-- true  → input is in g  -->
  <arg name="gyro_is_degrees"  default="true"/>   <!-- true  → input is deg/s -->

  <!-- Gravity magnitude [m/s²] -->
  <arg name="gravity_magnitude" default="9.80665"/>

  <!-- WLS solver sigma fed into the LC-FGO position prior [m] -->
  <arg name="wls_position_sigma" default="1.0"/>

  <!-- LC-FGO prior sigmas [rot_x, rot_y, rot_z, tx, ty, tz] -->
  <arg name="prior_pose_sigmas"  default="[0.5, 0.5, 0.5, 0.1, 0.1, 0.1]"/>
  <arg name="prior_vel_sigma"    default="0.1"/>
  <arg name="prior_bias_sigma"   default="0.01"/>

  <!-- LC-FGO update regularisation (keeps graph well-conditioned) -->
  <arg name="lc_update_vel_sigma"  default="2.0"/>
  <arg name="lc_update_bias_sigma" default="0.5"/>

  <!-- Integrity monitoring -->
  <!-- Per-anchor ranging noise floor [m].
       Calibrate from static measurements: sigma_single ≈ 0.03–0.08 m for UWB LOS.
       This value enters the monitor as sqrt(2)*sigma for the fallback diagonal path,
       and as 'base' in the dynamic model: sigma_i = base + slope * range_i.        -->
  <arg name="integrity_tdoa_noise_sigma" default="0.05"/>
  <arg name="integrity_p_fa"             default="0.001"/>
  <arg name="integrity_hal"              default="1.0"/>   <!-- [m] horiz alert limit -->
  <arg name="integrity_val"              default="2.0"/>   <!-- [m] vert  alert limit -->
  <arg name="integrity_ring_threshold"   default="0.10"/>   <!-- [m] ring-closure alarm -->
  <arg name="integrity_enable_fde"       default="true"/>
  <arg name="dynamic_tdoa_sigma_enabled" default="true"/>
  <!-- sigma_pair = sqrt(sigma_A² + sigma_B²)
       sigma_i    = base + slope * range_i
       base  = hardware noise floor (same as integrity_tdoa_noise_sigma above)
       slope = range-dependent growth: 0.005 m per metre → +0.04 m at 8 m range
       At 8 m:  sigma_i ≈ 0.05 + 0.005*8 = 0.09 m
                sigma_pair ≈ sqrt(2)*0.09 ≈ 0.127 m  →  HPL ≈ 0.43 m  (was 5.1 m)
       max   = hard cap; prevents HPL blow-up on distant / NLOS anchors           -->
  <arg name="tdoa_range_sigma_base"      default="$(arg integrity_tdoa_noise_sigma)"/>
  <arg name="tdoa_range_sigma_per_meter" default="0.005"/>
  <arg name="tdoa_pair_sigma_min"        default="0.001"/>
  <arg name="tdoa_pair_sigma_max"        default="0.50"/>

  <!-- Trajectory CSV log output path -->
  <arg name="trajectory_log_path"
       default="$(find uwb_imu_fusion)/output/uwb_wls_integrity_dynamic_weight_trajectory.csv"/>

  <rosparam ns="uwb_imu_fusion"
            file="$(arg config_file)"
            command="load"/>

  <!-- ═══════════════════════════════════════════════════════════════════════
       FUSION NODE
       ═══════════════════════════════════════════════════════════════════════ -->
  <node name="uwb_wls_integrity_node"
        pkg="uwb_imu_fusion"
        type="integrity_uwb_node"
        output="screen"
        required="true">

    <!-- ── Topic remappings ────────────────────────────────────────────── -->
    <remap from="imu_data"   to="$(arg imu_topic)"/>
    <remap from="tdoa_data"  to="$(arg uwb_topic)"/>
    <remap from="pose_data"  to="$(arg gt_topic)"/>

    <!-- ── Parameters that come from launch args (NOT in anchors.yaml) ── -->

    <!-- Frame IDs -->
    <param name="odom_frame"       value="$(arg odom_frame)"       type="str"/>
    <param name="base_frame"       value="$(arg base_frame)"       type="str"/>

    <!-- Topic names (node reads these with pnh_.param) -->
    <param name="imu_topic"        value="$(arg imu_topic)"        type="str"/>
    <param name="uwb_topic"        value="$(arg uwb_topic)"        type="str"/>
    <param name="gt_topic"         value="$(arg gt_topic)"         type="str"/>

    <!-- IMU unit flags -->
    <param name="imu_accel_in_g"   value="$(arg imu_accel_in_g)"  type="bool"/>
    <param name="gyro_is_degrees"  value="$(arg gyro_is_degrees)" type="bool"/>

    <!-- Physics -->
    <param name="gravity_magnitude" value="$(arg gravity_magnitude)" type="double"/>

    <!-- WLS → FGO coupling -->
    <param name="wls_position_sigma" value="$(arg wls_position_sigma)" type="double"/>

    <!-- FGO priors -->
    <rosparam param="prior_pose_sigmas"  subst_value="true">$(arg prior_pose_sigmas)</rosparam>
    <param name="prior_vel_sigma"    value="$(arg prior_vel_sigma)"    type="double"/>
    <param name="prior_bias_sigma"   value="$(arg prior_bias_sigma)"   type="double"/>

    <!-- FGO update regularisation -->
    <param name="lc_update_vel_sigma"  value="$(arg lc_update_vel_sigma)"  type="double"/>
    <param name="lc_update_bias_sigma" value="$(arg lc_update_bias_sigma)" type="double"/>

    <!-- ── Integrity monitoring ──────────────────────────────────────── -->
    <param name="integrity_tdoa_noise_sigma" value="$(arg integrity_tdoa_noise_sigma)" type="double"/>
    <param name="integrity_p_fa"             value="$(arg integrity_p_fa)"             type="double"/>
    <param name="integrity_hal"              value="$(arg integrity_hal)"              type="double"/>
    <param name="integrity_val"              value="$(arg integrity_val)"              type="double"/>
    <param name="integrity_ring_threshold"   value="$(arg integrity_ring_threshold)"   type="double"/>
    <param name="integrity_enable_fde"       value="$(arg integrity_enable_fde)"       type="bool"/>
    <param name="dynamic_tdoa_sigma_enabled" value="$(arg dynamic_tdoa_sigma_enabled)" type="bool"/>
    <param name="tdoa_range_sigma_base"      value="$(arg tdoa_range_sigma_base)"      type="double"/>
    <param name="tdoa_range_sigma_per_meter" value="$(arg tdoa_range_sigma_per_meter)" type="double"/>
    <param name="tdoa_pair_sigma_min"        value="$(arg tdoa_pair_sigma_min)"        type="double"/>
    <param name="tdoa_pair_sigma_max"        value="$(arg tdoa_pair_sigma_max)"        type="double"/>

    <!-- ── Logging ────────────────────────────────────────────────────── -->
    <param name="trajectory_log_path" value="$(arg trajectory_log_path)" type="str"/>

  </node>


</launch>
