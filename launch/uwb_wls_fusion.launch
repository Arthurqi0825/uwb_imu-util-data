<launch>

  <!-- =========================================================== -->
  <!-- uwb_imu_fusion — UWB + IMU fusion node                      -->
  <!-- =========================================================== -->

  <!-- Topic remapping -->
  <arg name="imu_topic"  default="/imu_data"   />
  <arg name="uwb_topic"  default="/tdoa_data"  />
  <arg name="gt_topic"   default="/pose_data"  />

  <!-- Visualization flags -->
  <arg name="enable_viz"  default="true" />
  <arg name="enable_rviz" default="true" />

  <!-- Frame IDs -->
  <arg name="odom_frame" default="map"       />
  <arg name="base_frame" default="base_link" />

  <!-- Log output path -->
  <arg name="residual_log_path"
       default="$(find uwb_imu_fusion)/output/uwb_imu_residuals.csv" />

  <!-- IMU physics -->
  <arg name="gravity_magnitude" default="0.0" />

  <!-- FGO prior sigmas -->
  <arg name="pose_prior_sigma" default="0.05" />
  <arg name="vel_prior_sigma"  default="0.5"  />
  <arg name="bias_prior_sigma" default="0.3"  />

  <!-- IMU noise model -->
  <arg name="imu_acc_noise"      default="0.1"   />
  <arg name="imu_gyro_noise"     default="0.01"  />
  <arg name="imu_acc_bias_noise" default="0.01"  />
  <arg name="imu_gyro_bias_noise"default="0.001" />

  <!-- UWB noise -->
  <arg name="tdoa_sigma" default="0.5" />

  <!-- Initial IMU bias (set if known from calibration) -->
  <arg name="initial_acc_bias_x"  default="0.0" />
  <arg name="initial_acc_bias_y"  default="0.0" />
  <arg name="initial_acc_bias_z"  default="0.0" />
  <arg name="initial_gyro_bias_x" default="0.0" />
  <arg name="initial_gyro_bias_y" default="0.0" />
  <arg name="initial_gyro_bias_z" default="0.0" />

  <!-- =========================================================== -->
  <!-- Anchor positions — edit to match your room setup            -->
  <!-- Each anchor: [x, y, z] in metres relative to world origin   -->
  <!-- =========================================================== -->
  <rosparam param="/uwb_imu_fusion/anchors">
    [
        [-2.4175, -4.0208, 0.1818],   
        [-2.8205, 3.5250, 2.5874] ,   
        [3.4819, 3.3050, 0.1545] ,    
        [3.4507, -3.7181, 2.6693] ,   
        [-3.2776, -3.8690, 2.6739],   
        [3.2655, -3.6511, 0.1752],    
        [3.8321, 3.6521, 2.6249] ,    
        [-2.7228, 3.2191, 0.1583]
    ]
  </rosparam>

  <!-- Optional UWB tag extrinsic (offset from body origin to UWB antenna) -->
  <rosparam param="/uwb_imu_fusion/anchor_extrinsic_translation">[-0.03,-0.05,-0.15]</rosparam>

  <!-- =========================================================== -->
  <!-- Fusion node                                                  -->
  <!-- =========================================================== -->
  <node pkg="uwb_imu_fusion"
        type="uwb_wls_fusion_node"
        name="uwb_wls_fusion_node"
        output="screen">

    <!-- Topic remapping -->
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="uwb_topic" value="$(arg uwb_topic)" />
    <param name="gt_topic"  value="$(arg gt_topic)"  />

    <!-- Frame IDs -->
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="base_frame" value="$(arg base_frame)" />

    <!-- Log -->
    <param name="residual_log_path" value="$(arg residual_log_path)" />

    <!-- IMU physics -->
    <param name="gravity_magnitude" value="$(arg gravity_magnitude)" />

    <!-- FGO priors -->
    <param name="pose_prior_sigma" value="$(arg pose_prior_sigma)" />
    <param name="vel_prior_sigma"  value="$(arg vel_prior_sigma)"  />
    <param name="bias_prior_sigma" value="$(arg bias_prior_sigma)" />

    <!-- IMU noise -->
    <param name="imu_acc_noise"       value="$(arg imu_acc_noise)"       />
    <param name="imu_gyro_noise"      value="$(arg imu_gyro_noise)"      />
    <param name="imu_acc_bias_noise"  value="$(arg imu_acc_bias_noise)"  />
    <param name="imu_gyro_bias_noise" value="$(arg imu_gyro_bias_noise)" />

    <!-- UWB noise -->
    <param name="tdoa_sigma" value="$(arg tdoa_sigma)" />

    <!-- Initial IMU bias -->
    <param name="initial_acc_bias_x"  value="$(arg initial_acc_bias_x)"  />
    <param name="initial_acc_bias_y"  value="$(arg initial_acc_bias_y)"  />
    <param name="initial_acc_bias_z"  value="$(arg initial_acc_bias_z)"  />
    <param name="initial_gyro_bias_x" value="$(arg initial_gyro_bias_x)" />
    <param name="initial_gyro_bias_y" value="$(arg initial_gyro_bias_y)" />
    <param name="initial_gyro_bias_z" value="$(arg initial_gyro_bias_z)" />

    <!-- UWB cycle tuning -->
    <param name="measurements_per_cycle" value="8"    />
    <param name="min_imu_per_cycle"      value="2"    />
    <param name="cycle_timeout"          value="0.02" />

    <!-- Robust noise model (Huber) -->
    <param name="use_robust_noise" value="true"  />
    <param name="huber_k"          value="1.345" />

  </node>

  <!-- =========================================================== -->
  <!-- RViz (optional)                                             -->
  <!-- =========================================================== -->
  <group if="$(arg enable_rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find uwb_imu_fusion)/rviz/fusion.rviz"
          required="false" />
  </group>

</launch>